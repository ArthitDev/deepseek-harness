{
  // Host aggregate (one of the two check units; see tsconfig.json). packages/client
  // type-checks in tsconfig.client.json: the two sides merge cordis Context under
  // the same keys, one program cannot see both.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
      "packages/experimental/cua-macos/tests/native-fixture.ts",
      "packages/client/ui-sidebar-documentpreview/tests/excel-fixture.ts",
      "packages/client/ui-sidebar-documentpreview/tests/excel-drawing-fixture.ts",
      "packages/client/ui-sidebar-documentpreview/tests/xls-fixture.ts",
      "packages/client/ui-sidebar-documentpreview/tests/pdf-fixture.ts",
      "packages/client/ui-sidebar-documentpreview/tests/excel-opening-fixture.ts",
      "packages/client/ui-sidebar-documentpreview/tests/excel-xml-fixture.ts",
      "packages/experimental/webworker-runtime/tests/vfs-example-fixture.ts",
      "packages/client/ui-sidebar-documentpreview/tests/excel-opc-fixture.ts",
      "packages/settings/settings/tests/live-config.ts",
      "packages/workflow/tool-ralph/src/index.ts",
  ],
  // Under packages/client and benchmarks, a test file names the face it covers:
  // `*.client.*` belongs to the Client aggregate, `*.host.spec.ts` to this one. The two
  // suffixes are mutually exclusive, so each aggregate excludes the other's
  // and the package test glob above needs no per-file entry.
  "exclude": [
    "apps/desktop/tests/keyboard.spec.ts",
    "packages/client/*/src/**",
    "benchmarks/**/*.client.ts",
    "benchmarks/**/*.client.tsx",
    "packages/client/tsdown.client.ts",
    "scripts/*.client.spec.ts",
    "scripts/client-bundle-css.spec.ts",
    "packages/typert/generator/tests/fixtures/**",
    "scripts/client-bundle-purity.spec.ts"
  ],
