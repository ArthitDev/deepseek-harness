// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`dsh-tool-subagent > derives inherited-context wording from a seeded-conversation provider > fork handoff 1`] = `"The task for the subagent. It already sees this conversation's completed turns, so build on them freely. Include new instructions and evidence from the current in-flight turn, which it cannot see. State the objective and success criteria, relevant paths or URLs and known evidence, scope and file ownership, whether you need findings, changes, or both, and the expected output. Ask for sources, changed files, checks run, and unresolved issues as applicable. When sharing files, tell the subagent to preserve concurrent edits and coordinate overlapping work."`;

exports[`dsh-tool-subagent > derives spawn-shaped wording from a fresh-conversation provider (default mock) > fresh handoff 1`] = `"The complete, self-contained task for the subagent. It does not share this conversation's context, so include everything it needs. State the objective and success criteria, relevant paths or URLs and known evidence, scope and file ownership, whether you need findings, changes, or both, and the expected output. Ask for sources, changed files, checks run, and unresolved issues as applicable. When sharing files, tell the subagent to preserve concurrent edits and coordinate overlapping work."`;

exports[`dsh-tool-subagent continuable background mode > defaults continuable delegation to background and returns only its durable id > continuable execution guidance 1`] = `"Use subagent in the background by default. Start independent delegations together in one assistant message and continue useful work while they run. Sequence dependent work after its prerequisite results are available; coordinate edits to shared files. Set \`run_in_background: false\` when your next action depends on that subagent's result. When a background run settles, the runtime sends you a notice containing its outcome and any final assistant message; avoid busy-polling. Review the returned evidence, changes, and checks before integrating the result."`;
