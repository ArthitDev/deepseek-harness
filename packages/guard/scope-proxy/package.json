{
  "name": "@deepseek-ai/dsh-scope-proxy",
  "description": "Scope-pinning forward proxy plugin: every connection is scope-judged, resolved once, and pinned to the validated address, closing the DNS rebinding race without a sandbox",
  "version": "0.1.0-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/guard/scope-proxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-pentest-run": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-shell-env": "workspace:*",
    "@deepseek-ai/dsh-shell": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-shell-env": "workspace:*",
    "@deepseek-ai/dsh-shell": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
