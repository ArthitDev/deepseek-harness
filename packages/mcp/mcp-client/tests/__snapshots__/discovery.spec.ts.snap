exports[`lazy MCP discovery > loads from YAML, searches, reads one schema, dispatches through native policy, and unloads > lazy tool schema 1`] = `
[
  {
    "description": "Discover MCP tools without loading every schema. List or search tools, read the schema of one tool, then call it with its exact public name and arguments. Calls use the same permission and scope checks as native tools.",
    "name": "mcp__fixture__discover_tools",
    "parameters": {
      "properties": {
        "action": {
          "enum": [
            "list",
            "search",
            "schema",
            "call",
          ],
          "type": "string",
        },
        "arguments": {
          "additionalProperties": true,
          "description": "Arguments matching the selected schema, for call only.",
          "type": "object",
        },
        "offset": {
          "description": "Non-negative result offset for list or search.",
          "type": "integer",
        },
        "query": {
          "description": "Search terms, matched against tool names and descriptions.",
          "type": "string",
        },
        "tool": {
          "description": "Exact public tool name returned by list or search.",
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
  },
]
`;

